# Copy to demo/.env and fill in a machine you own. stage.sh reads it if it is
# there, so `vhs shots.tape` and `vhs demo.tape` work without exporting anything.
#
# Only `raspi` uses these, and only because a tunnel, a mount and a login cannot
# be faked - they need a server that really speaks ssh. Every other host in the
# staged config stays fake. The frames show the alias `raspi` and never the
# address, but a login shown in the GIF prints that machine's banner and prompt.
#
# demo/.env is gitignored. Leave it out and the mount and tunnel scenes will
# report that ssh refused them, which is also worth seeing once.

ESSH_DEMO_HOST=10.0.0.5
ESSH_DEMO_USER=you
ESSH_DEMO_KEY=~/.ssh/id_ed25519
# ESSH_DEMO_PORT=22
